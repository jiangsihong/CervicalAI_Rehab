# Copy to .env locally. Never commit your real authorization code or password.
# Sender configuration is independent of patients' email providers.
MAIL_HOST=
MAIL_PORT=465
# Use ssl (usually 465) or starttls (usually 587), as required by your provider.
MAIL_SECURITY=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Use long independent random secrets; changing these invalidates existing tokens/codes.
SECRET_KEY=
JWT_SECRET_KEY=
